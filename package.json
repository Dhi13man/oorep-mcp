{
  "name": "oorep-mcp",
  "version": "1.2.1",
  "description": "MCP server for OOREP homeopathic repertory and materia medica - enables AI assistants to search symptoms, remedies, and homeopathic reference materials",
  "mcpName": "io.github.dhi13man/oorep-mcp",
  "type": "module",
  "main": "dist/sdk/index.js",
  "types": "dist/sdk/index.d.ts",
  "bin": {
    "oorep-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./sdk/openai": {
      "types": "./dist/sdk/adapters/openai.d.ts",
      "import": "./dist/sdk/adapters/openai.js"
    },
    "./sdk/vercel-ai": {
      "types": "./dist/sdk/adapters/vercel-ai.d.ts",
      "import": "./dist/sdk/adapters/vercel-ai.js"
    },
    "./sdk/langchain": {
      "types": "./dist/sdk/adapters/langchain.d.ts",
      "import": "./dist/sdk/adapters/langchain.js"
    },
    "./sdk/google-genai": {
      "types": "./dist/sdk/adapters/google-genai.d.ts",
      "import": "./dist/sdk/adapters/google-genai.js"
    },
    "./sdk/adapters": {
      "types": "./dist/sdk/adapters/index.d.ts",
      "import": "./dist/sdk/adapters/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && node test-e2e.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" --end-of-line auto",
    "format:check": "prettier --check \"src/**/*.ts\" --end-of-line auto",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run format:check && npm run build && npm run lint && npm run test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "server",
    "sdk",
    "ai-sdk",
    "openai",
    "langchain",
    "vercel-ai",
    "function-calling",
    "tool-calling",
    "oorep",
    "homeopathy",
    "repertory",
    "materia-medica",
    "remedies",
    "symptoms"
  ],
  "author": "Dhiman Seal <dhiman.seal@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dhi13man/oorep-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Dhi13man/oorep-mcp/issues"
  },
  "homepage": "https://github.com/Dhi13man/oorep-mcp#readme",
  "funding": "https://www.buymeacoffee.com/dhi13man",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "@napi-rs/wasm-runtime": "1.1.6"
  }
}
